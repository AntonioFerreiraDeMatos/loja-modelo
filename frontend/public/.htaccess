RewriteEngine On
# Redireciona o domínio sem www para www (genérico). Nunca redireciona a API (api.).
RewriteCond %{HTTP_HOST} !^(www|api)\. [NC]
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# HTML sempre revalidado, para o navegador pegar a versão nova após cada publicação.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Arquivos em /assets têm hash no nome; podem ficar em cache por 1 ano.
  <FilesMatch "\.(js|css|png|jpg|jpeg|webp|jfif|mp4|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
